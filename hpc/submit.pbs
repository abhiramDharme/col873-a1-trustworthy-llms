#!/bin/bash
#PBS -N default
#PBS -P vision.cse.spons
#PBS -q scai_q
#PBS -l select=1:ncpus=20:ngpus=1:mem=64gb:centos=amdepyc
#PBS -l walltime=24:00:00
#PBS -m n
#PBS -o /scratch/cse/dual/cs5221139/col873_a1/logs/default.out
#PBS -e /scratch/cse/dual/cs5221139/col873_a1/logs/default.err

set -eo pipefail
cd /scratch/cse/dual/cs5221139/col873_a1
mkdir -p logs adapters results .hf

set +u
# shellcheck disable=SC1090
source "${HOME}/.bashrc" || true
set -u
if conda activate col873 2>/dev/null; then
  echo "activated col873"
else
  conda activate col871
  echo "activated col871 (col873 not found)"
fi

export A1_ROOT="/scratch/cse/dual/cs5221139/col873_a1"
export A1_DATA="${A1_ROOT}/data"
export A1_OUT="${A1_ROOT}"
export HF_HOME="${A1_ROOT}/.hf"
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export OMP_NUM_THREADS=1
# Part A adapters are already on disk; skip the sweep and finish B+C.
export STAGE="${STAGE:-bc}"
unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY
export no_proxy="*"

echo "host=$(hostname) job=${PBS_JOBID:-} date=$(date -Is)"
echo "python=$(which python)"
nvidia-smi || true
python - <<'PY'
import torch
print("torch", torch.__version__, "cuda", torch.version.cuda)
print("cuda_available", torch.cuda.is_available())
if torch.cuda.is_available():
    props = torch.cuda.get_device_properties(0)
    print("gpu", torch.cuda.get_device_name(0), "cc", torch.cuda.get_device_capability(), "gb", round(props.total_memory / 1024**3, 1))
PY

bash "${A1_ROOT}/run_all.sh"
